{
  "manifest_version": 3,
  "name": "Lock In — Site Blocker",
  "version": "1.3.0",
  "description": "Block distracting sites with schedules, daily limits, groups, and a typing challenge before weakening your rules.",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_title": "Lock In",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/pages/options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/pages/blocked/blocked.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
