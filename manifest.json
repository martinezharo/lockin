{
  "manifest_version": 3,
  "name": "Lock In — Site Blocker",
  "version": "1.4.1",
  "description": "Manage scheduled site blocks and daily limits enforced by a protected local Windows watchdog.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/fragment-blocker.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_title": "Lock In",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/pages/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
